//@version=6
strategy("Mean Reversion Probability Zones", overlay=true, margin_long=100, margin_short=100)

// ＩＮＰＵＴＳ ――――――――――――――――――――――――――――――――――――――――――――――――――――――――――――――――――――――――――――――――――――――――――――――――――――――――{
// Original indicator inputs
oscillatorType = input.string("Stochastic", "RSI", ["RSI", "MFI", "Stochastic"])
oscLength      = input.int(50, "Length")
zoneUpper      = input.int(50, "Upper Zone", inline = "Upper")
zoneUpColor    = input.color(#ff00aa, "", inline = "Upper")
zoneLower      = input.int(50, "Lower Zone", inline = "Lower")
zoneDnColor    = input.color(color.rgb(0, 255, 191), "", inline = "Lower")

// Trade direction
tradeLong      = input.bool(true, "Enable Long Trades")
tradeShort     = input.bool(true, "Enable Short Trades")

// Entry logic
entryLogic     = input.string("Zone", "Entry Logic", ["Zone", "Threshold", "Zone or Threshold", "Zone and Threshold"])
longEntryThresh  = input.float(70.0, "Long Entry Threshold (%)", minval=1, maxval=100, group="Long Thresholds")
longExitThresh   = input.float(30.0, "Long Exit Threshold (%)", minval=1, maxval=100, group="Long Thresholds")
shortEntryThresh = input.float(70.0, "Short Entry Threshold (%)", minval=1, maxval=100, group="Short Thresholds")
shortExitThresh  = input.float(30.0, "Short Exit Threshold (%)", minval=1, maxval=100, group="Short Thresholds")

// Exit logic
exitLogic      = input.string("Zone", "Exit Logic", ["Zone", "Threshold", "Zone or Threshold", "Zone and Threshold"])

// Optional risk management
useRisk        = input.bool(false, "Enable Stop Loss / Take Profit")
riskType       = input.string("Percent", "Risk Type", ["Percent", "ATR"], group="Risk Management")
stopPercent    = input.float(2.0, "Stop Loss %", step=0.1, group="Risk Management")
takePercent    = input.float(5.0, "Take Profit %", step=0.1, group="Risk Management")
atrLength      = input.int(14, "ATR Length", group="Risk Management")
atrMultStop    = input.float(2.0, "ATR Multiplier for Stop", step=0.1, group="Risk Management")
atrMultTake    = input.float(3.0, "ATR Multiplier for Take", step=0.1, group="Risk Management")

// Dynamic trailing stop (new)
useTrailingStop = input.bool(false, "Use Trailing Stop (instead of fixed stop)", group="Risk Management")
// }


// ＣＡＬＣＵＬＡＴＩＯＮＳ――――――――――――――――――――――――――――――――――――――――――――――――――――――――――――――――――――――――――――――――――――――――――――――{
// Stochastic RSI helper function
stochRsi(srcLen) =>
    rsiValue = ta.rsi(close, srcLen)
    kLine    = ta.sma(ta.stoch(rsiValue, rsiValue, rsiValue, 14), 3)
    kLine

// Select oscillator
float oscValue = switch oscillatorType
    "RSI"        => ta.rsi(close, oscLength)
    "MFI"        => ta.mfi(hlc3, oscLength)
    "Stochastic" => stochRsi(oscLength)

// Calculate differences and percentiles
downMove        = oscValue[2] - oscValue
downPercentile  = ta.percentile_nearest_rank(downMove, 200, 100)

upMove          = oscValue - oscValue[2]
upPercentile    = ta.percentile_nearest_rank(upMove, 200, 100)

// Downward probability calculations
probDownRaw   = oscValue > zoneUpper ? downMove / downPercentile : 0
probDownRaw   := probDownRaw < 0 ? 0 : probDownRaw
probDownFinal = ta.highest(probDownRaw, 10)  * oscValue
probDownHighest = ta.highest(probDownFinal, 2000) 

// Upward probability calculations
probUpRaw     = oscValue < zoneLower ? upMove / upPercentile : 0
probUpRaw     := probUpRaw < 0 ? 0 : probUpRaw
probUpFinal   = ta.highest(probUpRaw, 10) * (100 - oscValue)
probUpHighest = ta.highest(probUpFinal, 2000) 

// Probability colors
probDownFillColor   = color.from_gradient(probDownFinal, 0, 100, color.new(zoneUpColor, 90), zoneUpColor)
probUpFillColor     = color.from_gradient(probUpFinal, 0, 100, color.new(zoneDnColor, 90), zoneDnColor)
probDownBorderColor = color.from_gradient(probDownFinal, 0, 100, color.new(zoneUpColor, 50), zoneUpColor)
probUpBorderColor   = color.from_gradient(probUpFinal, 0, 100, color.new(zoneDnColor, 50), zoneDnColor)
// }


// ＰＬＯＴ ――――――――――――――――――――――――――――――――――――――――――――――――――――――――――――――――――――――――――――――――――――――――――――――――――――――――――――{
upperOffset = 125
lowerOffset = 25

plotDownZone = plot(upperOffset - probDownFinal, "Mean Reversion Down", color = probDownBorderColor, style = plot.style_stepline)
plotDownRef  = plot(zoneUpper, color = color(na), editable = false)
plotUpZone   = plot(-lowerOffset + probUpFinal, "Mean Reversion Up", color = probUpBorderColor, style = plot.style_stepline)
plotUpRef    = plot(zoneLower, color = color(na), editable = false)

hline(zoneUpper, "Upper Threshold")
plot (oscValue, "Oscillator", color = chart.fg_color, linewidth = 2)
hline(zoneLower, "Lower Threshold")

// Shapes
upper = ta.highest(50)
plotshape(probDownFinal > 0 ? upper : float(na), "Down Probability", shape.square, location.absolute, probDownFillColor, force_overlay = true, size = size.tiny)
lower = ta.lowest(50)
plotshape(probUpFinal > 0 ? lower : float(na), "Up Probability", shape.square, location.absolute, probUpFillColor, force_overlay = true, size = size.tiny)

// Fills – corrected: only plot IDs and color
fill(plotDownZone, plotDownRef, color.new(zoneUpColor, 90))
fill(plotUpZone, plotUpRef, color.new(zoneDnColor, 90))

var dash = table.new(position.bottom_right, 100, 100)
var label downLabel = na
var label upLabel = na

// Labels and dash (last bar only)
if barstate.islast
    // Delete previous labels to avoid accumulation
    if not na(downLabel)
        label.delete(downLabel)
    if not na(upLabel)
        label.delete(upLabel)
    // Create new labels
    downLabel := label.new(bar_index, upperOffset - probDownFinal, str.tostring(probDownFinal, format.percent), style = label.style_label_left, color = probDownBorderColor, textcolor = chart.fg_color)
    upLabel := label.new(bar_index, -lowerOffset + probUpFinal, str.tostring(probUpFinal, format.percent), style = label.style_label_left, color = probUpBorderColor, textcolor = chart.fg_color)
    // Update table cells – corrected syntax
    table.cell(dash, 0, 0, "Recent MAX value ▼: " + str.tostring(probDownHighest, format.percent), text_color = zoneUpColor)
    table.cell(dash, 0, 1, "Recent MAX value ▲: " + str.tostring(probUpHighest, format.percent), text_color = zoneDnColor)
// }


// ＳＴＲＡＴＥＧＹ  ＬＯＧＩＣ ――――――――――――――――――――――――――――――――――――――――――――――――――――――――――――――――――――――――――――――――――――――――――{
// Zone conditions
zoneLong  = nz(probUpFinal) > 0
zoneShort = nz(probDownFinal) > 0

// Threshold conditions (crossover for entry, crossunder for exit)
longEntryThreshCond  = ta.crossover(probUpFinal, longEntryThresh)
longExitThreshCond   = ta.crossunder(probUpFinal, longExitThresh)
shortEntryThreshCond = ta.crossover(probDownFinal, shortEntryThresh)
shortExitThreshCond  = ta.crossunder(probDownFinal, shortExitThresh)

// Entry conditions based on selected logic
bool longEntry  = false
bool shortEntry = false
bool longExit   = false
bool shortExit  = false

// Long entry
if entryLogic == "Zone"
    longEntry := zoneLong
else if entryLogic == "Threshold"
    longEntry := longEntryThreshCond
else if entryLogic == "Zone or Threshold"
    longEntry := zoneLong or longEntryThreshCond
else if entryLogic == "Zone and Threshold"
    longEntry := zoneLong and longEntryThreshCond

// Short entry
if entryLogic == "Zone"
    shortEntry := zoneShort
else if entryLogic == "Threshold"
    shortEntry := shortEntryThreshCond
else if entryLogic == "Zone or Threshold"
    shortEntry := zoneShort or shortEntryThreshCond
else if entryLogic == "Zone and Threshold"
    shortEntry := zoneShort and shortEntryThreshCond

// Exit conditions based on selected logic
if exitLogic == "Zone"
    longExit  := not zoneLong
    shortExit := not zoneShort
else if exitLogic == "Threshold"
    longExit  := longExitThreshCond
    shortExit := shortExitThreshCond
else if exitLogic == "Zone or Threshold"
    longExit  := not zoneLong or longExitThreshCond
    shortExit := not zoneShort or shortExitThreshCond
else if exitLogic == "Zone and Threshold"
    longExit  := not zoneLong and longExitThreshCond
    shortExit := not zoneShort and shortExitThreshCond

// Risk management calculations
atr = ta.atr(atrLength)
longStop  = useRisk ? (riskType == "Percent" ? strategy.position_avg_price * (1 - stopPercent/100) : strategy.position_avg_price - atr * atrMultStop) : na
longTake  = useRisk ? (riskType == "Percent" ? strategy.position_avg_price * (1 + takePercent/100) : strategy.position_avg_price + atr * atrMultTake) : na
shortStop = useRisk ? (riskType == "Percent" ? strategy.position_avg_price * (1 + stopPercent/100) : strategy.position_avg_price + atr * atrMultStop) : na
shortTake = useRisk ? (riskType == "Percent" ? strategy.position_avg_price * (1 - takePercent/100) : strategy.position_avg_price - atr * atrMultTake) : na

// --- Dynamic trailing stop implementation ---
// Store trail offset (in price) calculated at entry time
var float longTrailPoints = na
var float shortTrailPoints = na

// Reset trail points when position is closed
if strategy.position_size == 0
    longTrailPoints := na
    shortTrailPoints := na

// Update trail points on new entry signals (using current bar's close as proxy for entry price)
if tradeLong and longEntry
    stopPrice = riskType == "Percent" ? close * (1 - stopPercent/100) : close - atr * atrMultStop
    longTrailPoints := close - stopPrice   // positive distance for long trail
if tradeShort and shortEntry
    stopPrice = riskType == "Percent" ? close * (1 + stopPercent/100) : close + atr * atrMultStop
    shortTrailPoints := stopPrice - close   // positive distance for short trail

// Entries
if tradeLong and longEntry
    strategy.entry("Long", strategy.long, comment="Long Entry")
if tradeShort and shortEntry
    strategy.entry("Short", strategy.short, comment="Short Entry")

// Exits (manual signals)
if longExit and strategy.position_size > 0
    strategy.close("Long", comment="Long Exit")
if shortExit and strategy.position_size < 0
    strategy.close("Short", comment="Short Exit")

// Optional risk exits (fixed stop/take OR trailing stop)
if useRisk
    if useTrailingStop
        // Use trailing stop (with same distance as fixed stop would have) and take profit
        if strategy.position_size > 0 and not na(longTrailPoints)
            strategy.exit("Long Trail/TP", "Long", limit=longTake, trail_points=longTrailPoints)
        if strategy.position_size < 0 and not na(shortTrailPoints)
            strategy.exit("Short Trail/TP", "Short", limit=shortTake, trail_points=shortTrailPoints)
    else
        // Use fixed stop loss and take profit
        strategy.exit("Long TP/SL", "Long", stop=longStop, limit=longTake)
        strategy.exit("Short TP/SL", "Short", stop=shortStop, limit=shortTake)
// }
